{
  "name": "fix-pob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:turbo": "next dev --turbopack",
    "pob2:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-pob2-engine.ps1",
    "pob2:test": "powershell -ExecutionPolicy Bypass -File scripts/test-pob2-engine.ps1",
    "pob2:character": "node scripts/prepare-pob2-character.cjs",
    "pob:export-test": "node scripts/test-v210-contract.cjs",
    "pob2:character-test": "powershell -ExecutionPolicy Bypass -File scripts/test-pob2-engine.ps1 -Character",
    "pob2:native-audit": "node scripts/test-v225-native-integrity.cjs",
    "pob2:fingerprint": "node scripts/check-pob2-fingerprint.cjs",
    "pob2:native-wasm": "node scripts/test-v225-native-wasm.mjs",
    "pob2:comparison-guard": "node scripts/test-v225-comparison-guard.cjs",
    "pob:ring-slots-test": "node --experimental-strip-types scripts/test-v226-ring-slots.cjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
