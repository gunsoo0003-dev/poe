{
  "manifest_version": 3,
  "name": "FIXLGS POE2 Item Export",
  "version": "0.4.6",
  "description": "Copy Path of Exile 2 trade items as English item text for FIXLGS PoB2 comparisons.",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.pathofexile.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/trade2/*",
        "https://pathofexile.com/trade2/*",
        "https://poe.kakaogames.com/trade2/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://www.pathofexile.com/*",
        "https://pathofexile.com/*",
        "https://poe.kakaogames.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
